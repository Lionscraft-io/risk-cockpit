{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lionscraft desk dataset",
  "description": "Shape of data/desk.json. Unknown fields are allowed everywhere and must be preserved by writers — see AGENTS.md.",
  "type": "object",
  "required": ["version", "meta", "partners", "workstreams", "tasks", "milestones"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "meta": {
      "type": "object",
      "required": ["org", "facility", "product", "revision", "updated"],
      "properties": {
        "org": { "type": "string" },
        "facility": { "type": "string" },
        "product": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "updated": { "$ref": "#/definitions/date" }
      }
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "cat", "stage"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "cat": { "enum": ["carrier", "capital", "donor", "dfi", "operator", "digital", "data", "verifier", "public"] },
          "country": { "type": "string" },
          "why": { "type": "string" },
          "ask": { "type": "string" },
          "stage": { "enum": ["identified", "researched", "approached", "meeting", "mou_sent", "mou_signed", "active", "parked", "declined"] },
          "owner": { "type": "string" },
          "contact": { "type": "string" },
          "next": { "type": "string" },
          "nextDate": { "$ref": "#/definitions/dateOrEmpty" },
          "notes": { "type": "string" },
          "seeded": { "type": "boolean" }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^WS[0-9]+$" },
          "name": { "type": "string" },
          "layer": { "type": "string" },
          "lead": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ws", "title", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ws": { "type": "string", "pattern": "^WS[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "start": { "$ref": "#/definitions/dateOrEmpty" },
          "due": { "$ref": "#/definitions/dateOrEmpty" },
          "status": { "enum": ["todo", "doing", "blocked", "done"] },
          "partner": { "type": "string" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "date", "hit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "date": { "$ref": "#/definitions/date" },
          "hit": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "activity": {
      "type": "array",
      "description": "Append-only. Never edit or delete an existing entry.",
      "items": {
        "type": "object",
        "required": ["id", "at", "actor", "actorKind", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "minLength": 1 },
          "actorKind": { "enum": ["human", "agent"] },
          "kind": { "enum": ["comment", "change", "finding", "question", "handoff"] },
          "refType": { "enum": ["partner", "task", "milestone", "board"] },
          "ref": { "type": "string" },
          "body": { "type": "string" },
          "summary": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "dateOrEmpty": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" }
  }
}
