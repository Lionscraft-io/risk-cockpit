{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lionscraft desk dataset",
  "description": "Shape of the board once assembled from the files under data/ (meta.json, partners/partners.json, plan/*.json, activity/activity.json). Unknown fields are allowed everywhere and must be preserved by writers — see AGENTS.md.",
  "type": "object",
  "required": [
    "version",
    "meta",
    "partners",
    "workstreams",
    "tasks",
    "milestones",
    "columns",
    "stages"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "org",
        "facility",
        "product",
        "revision",
        "updated"
      ],
      "properties": {
        "org": {
          "type": "string"
        },
        "facility": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated": {
          "$ref": "#/definitions/date"
        }
      }
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cat",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cat": {
            "enum": [
              "carrier",
              "capital",
              "donor",
              "dfi",
              "operator",
              "digital",
              "data",
              "verifier",
              "public"
            ]
          },
          "country": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "ask": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "description": "A stage id from stages[]."
          },
          "owner": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "nextDate": {
            "$ref": "#/definitions/dateOrEmpty"
          },
          "lastDate": {
            "$ref": "#/definitions/dateOrEmpty"
          },
          "notes": {
            "type": "string"
          },
          "seeded": {
            "type": "boolean"
          }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WS[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "lead": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ws",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ws": {
            "type": "string",
            "pattern": "^WS[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "start": {
            "$ref": "#/definitions/dateOrEmpty"
          },
          "due": {
            "$ref": "#/definitions/dateOrEmpty"
          },
          "status": {
            "type": "string",
            "description": "A column id from columns[]."
          },
          "partner": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Cross-board tags. A task labelled \"risk\" is shared with the workforce board."
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "date",
          "hit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "$ref": "#/definitions/date"
          },
          "hit": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "description": "Append-only. Never edit or delete an existing entry.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "actor",
          "actorKind",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "actorKind": {
            "enum": [
              "human",
              "agent"
            ]
          },
          "kind": {
            "enum": [
              "comment",
              "change",
              "finding",
              "question",
              "handoff"
            ]
          },
          "refType": {
            "enum": [
              "partner",
              "task",
              "milestone",
              "board",
              "event",
              "investor"
            ]
          },
          "ref": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "description": "Board columns, in order. A task's status is a column id; the last column means done.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "description": "Partner pipeline stages in order. A partner's stage is a stage id. engaged marks where a real conversation has begun, committed where something is signed, terminal takes a partner out of the pipeline.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string"
          },
          "engaged": {
            "type": "boolean"
          },
          "committed": {
            "type": "boolean"
          },
          "terminal": {
            "type": "boolean"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "$ref": "#/definitions/date"
          },
          "end": {
            "$ref": "#/definitions/dateOrEmpty"
          },
          "time": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "partner": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "investors": {
      "type": "array",
      "description": "The investor space for the raise. tier A = in the space and writes this stage; B = in the space, wrong stage or type; C = adjacent, no insurance thesis; X = checked, no evidence of insurance, risk-transfer or RWA investing.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "tier",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "insurtech",
              "reinsurer",
              "ils",
              "climate",
              "dfi",
              "fintech",
              "crypto_rwa",
              "crypto",
              "growth",
              "sovereign",
              "bank",
              "strategic"
            ]
          },
          "geo": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C",
              "X"
            ]
          },
          "writes": {
            "type": "string"
          },
          "thesis": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "precedents": {
            "type": "string"
          },
          "warm": {
            "type": "string"
          },
          "ask": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "identified",
              "researched",
              "approached",
              "meeting",
              "diligence",
              "term_sheet",
              "committed",
              "passed",
              "parked"
            ]
          },
          "notes": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "description": "Order within the tier. 0 = unranked."
          },
          "link": {
            "type": "string",
            "description": "Verified website, http(s), or empty."
          },
          "sourceUrl": {
            "type": "string",
            "description": "Where the evidence line came from, http(s), or empty."
          },
          "year": {
            "type": "integer",
            "minimum": 0,
            "description": "Latest dated deal in the evidence. 0 = undated."
          }
        }
      }
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateOrEmpty": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    }
  }
}
